{
  "productName": "内容港 Harbour",
  "version": "0.12.0",
  "identifier": "com.harbour.hub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../server/static"
  },
  "app": {
    "windows": [
      {
        "title": "内容港 Harbour",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app"],
    "externalBin": [
      "binaries/harbour-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "AI 多平台内容发布中枢",
    "longDescription": "港 Harbour：AI 写稿 + AIGC 合规门禁 + 15 个内容平台分发与更新" ,
    "copyright": "harbour",
    "category": "Productivity"
  }
}
