{
  "productName": "内容港 Harbor",
  "version": "0.7.0",
  "identifier": "com.contentharbor.hub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "内容港 Harbor",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/content-harbor-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "AI 多平台内容发布中枢",
    "longDescription": "港 Harbor：AI 写稿 + AIGC 合规门禁 + 10 平台一键分发与原地更新",
    "copyright": "content-harbor",
    "category": "Productivity"
  }
}
