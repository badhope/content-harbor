# 环境选择：development | testing | staging | production | docker
FASTAPI_ENV=development

# 应用
PROJECT_NAME=内容港 Harbor（harbor）
PROJECT_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG
API_VERSION=v1
API_PREFIX=/api/v1

# 数据库（本地开发默认 SQLite，无需额外服务即可启动；生产可改为 mysql+aiomysql://...）
DATABASE_URL=sqlite+aiosqlite:///./data/hub.db

# JWT / 安全（生产必须覆盖）
SECRET_KEY=dev-secret-key-not-for-production-use-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# Redis（可选；cache_enabled=false 时用内存缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=false
CACHE_TTL=300
CACHE_PREFIX=fastapi_security

# 自定义安全中间件（默认关闭）
MIDDLEWARE_SECURITY_HEADERS_ENABLED=false
MIDDLEWARE_RATE_LIMIT_ENABLED=false
MIDDLEWARE_AUDIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20
